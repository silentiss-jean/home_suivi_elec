# -*- coding: utf-8 -*-
"""
Détection automatique des capteurs power/energy depuis Home Assistant.

PRIORITÉS :
  1. Energy (kWh) physique > Power (W) physique
  2. Energy virtuel (PowerCalc, Template) > Power virtuel
  3. Physique > Virtuel (pour un même appareil)

TAGS ENRICHIS :
  - is_virtual: true/false (sensor sans device_id physique)
  - integration: platform source (tplink, powercalc, tuya, etc.)
  - reference_type: "physical" | "calculated" | "template"
  - reliability_score: 0-100 (confiance dans la mesure)
  - priority: score de priorité (plus haut = meilleur)
  - duplicate_rank: rang dans le groupe de doublons (1 = meilleur)
  - alternatives: liste des sensors équivalents pour tests A/B

GESTION DES DOUBLONS :
  - Backend MARQUE les doublons mais ne les désactive PAS
  - Frontend décide quoi afficher/activer
  - Permet tests A/B et comparaisons physique vs virtuel
"""
import os
import json
import yaml
import logging
from typing import Any, Dict, List, Optional, Tuple

_LOGGER = logging.getLogger(__name__)

DATA_DIR = os.path.join(os.path.dirname(__file__), "data")
_QUALITY_MAP_FILE = os.path.join(DATA_DIR, "integration_quality.yaml")
_CAPTEURS_FILE = os.path.join(DATA_DIR, "capteurs_power.json")

# ==================== CONFIGURATION ====================

# Intégrations considérées comme "virtuelles" (estimation)
VIRTUAL_INTEGRATIONS = {
    "powercalc": {"reliability": 75, "type": "calculated"},
    "template": {"reliability": 50, "type": "template"},
    "utility_meter": {"reliability": 90, "type": "helper"},
    "integration": {"reliability": 85, "type": "helper"},  # Riemann sum integration
}

# Matrice de priorités (plus haut = meilleur)
# Format : (sensor_type, reference_type) -> priority
PRIORITY_MAP = {
    ("energy", "physical"): 100,  # Energy physique (meilleur)
    ("power", "physical"): 80,    # Power physique
    ("energy", "calculated"): 60, # Energy PowerCalc
    ("energy", "helper"): 55,     # Energy helper (utility_meter)
    ("energy", "template"): 50,   # Energy template
    ("power", "calculated"): 40,  # Power PowerCalc
    ("power", "template"): 30,    # Power template
    ("power", "helper"): 35,      # Power helper
}

# ==================== HELPERS ====================

def __read_json_sync(path: str) -> Any:
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)

def __write_json_sync(path: str, data: Any) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

def __load_quality_map_sync() -> Dict[str, str]:
    if not os.path.exists(_QUALITY_MAP_FILE):
        return {}
    with open(_QUALITY_MAP_FILE, "r", encoding="utf-8") as f:
        data = yaml.safe_load(f) or {}
        return {str(k): str(v) for k, v in data.items()}

def __is_premium(quality_scale: str) -> bool:
    return quality_scale in ("platinum", "gold")

def __device_signature(c: Dict[str, Any]) -> str:
    """
    Signature basée sur nom + zone pour détecter les doublons.
    Normalise pour éviter faux négatifs.
    """
    name = (c.get("friendly_name") or c.get("nom") or "").strip().lower()
    # Nettoyer les variations courantes
    name = name.replace("device energy", "").replace("today energy", "")
    name = name.replace("consommation", "").replace("puissance", "")
    name = name.strip()
    
    zone = (c.get("zone") or "").strip().lower()
    return f"{name}|{zone}"

# ==================== CLASSIFICATION ====================

def __classify_sensor(state) -> str:
    """Détermine si un sensor est 'energy' (kWh) ou 'power' (W)."""
    if not state:
        return "unknown"
    
    attrs = state.attributes or {}
    unit = str(attrs.get("unit_of_measurement", "")).strip().lower()
    device_class = str(attrs.get("device_class", "")).strip().lower()
    
    # Priorité device_class
    if device_class == "energy":
        return "energy"
    if device_class == "power":
        return "power"
    
    # Fallback unité
    if unit in ("kwh", "wh", "mwh"):
        return "energy"
    if unit in ("w", "watt", "watts", "kw"):
        return "power"
    
    return "unknown"


def __get_reference_type(platform: str, has_device_id: bool) -> Tuple[str, int]:
    """
    Détermine le type de référence et sa fiabilité.
    Returns: (reference_type, reliability_score)
    """
    if has_device_id:
        # Capteur physique
        return ("physical", 100)
    
    # Capteur virtuel
    if platform in VIRTUAL_INTEGRATIONS:
        config = VIRTUAL_INTEGRATIONS[platform]
        return (config["type"], config["reliability"])
    
    # Virtuel inconnu (template custom, etc.)
    return ("unknown", 30)


def __get_priority(sensor_type: str, reference_type: str) -> int:
    """Calcule la priorité d'un sensor basée sur type + source."""
    return PRIORITY_MAP.get((sensor_type, reference_type), 0)


# ==================== DÉTECTION ====================

def __detect_from_hass(hass) -> List[Dict[str, Any]]:
    """
    Détecte automatiquement les sensors depuis Home Assistant.
    Supporte devices physiques ET virtuels (PowerCalc, Template, Helpers).
    
    Returns: Liste de sensors avec métadonnées enrichies
    """
    try:
        from homeassistant.helpers import (
            entity_registry as er,
            device_registry as dr,
            area_registry as ar,
        )
    except ImportError:
        _LOGGER.error("Impossible d'importer les registries HA")
        return []
    
    entity_reg = er.async_get(hass)
    device_reg = dr.async_get(hass)
    area_reg = ar.async_get(hass)
    
    # Grouper sensors par device_id (réel ou virtuel)
    devices: Dict[str, Dict[str, Any]] = {}
    
    for state in hass.states.async_all("sensor"):
        entity_id = state.entity_id
        
        # Ignorer sensors HSE (créés par nous)
        if entity_id.startswith("sensor.hse_"):
            continue
        
        # Classifier
        sensor_type = __classify_sensor(state)
        if sensor_type == "unknown":
            continue
        
        # Récupérer entity_registry entry
        entry = entity_reg.async_get(entity_id)
        if not entry:
            continue
        
        # Récupérer device_id (réel ou créer virtuel)
        device_id = entry.device_id
        is_virtual = not device_id
        platform = entry.platform or "unknown"
        
        # Créer device_id virtuel si nécessaire
        if is_virtual:
            safe_name = entity_id.replace("sensor.", "")[:50]
            device_id = f"virtual_{platform}_{safe_name}"
        
        # Initialiser device (réel ou virtuel)
        if device_id not in devices:
            if is_virtual:
                # Device virtuel
                devices[device_id] = {
                    "device_id": device_id,
                    "name": state.attributes.get("friendly_name", entity_id),
                    "manufacturer": platform.capitalize(),
                    "model": "Virtual Sensor",
                    "area": "",
                    "is_virtual": True,
                    "sensors": {"energy": [], "power": []}
                }
            else:
                # Device réel
                device = device_reg.async_get(device_id)
                if not device:
                    continue
                
                area = None
                if device.area_id:
                    area = area_reg.async_get_area(device.area_id)
                
                devices[device_id] = {
                    "device_id": device_id,
                    "name": device.name or "Unknown",
                    "manufacturer": device.manufacturer,
                    "model": device.model,
                    "area": area.name if area else "",
                    "is_virtual": False,
                    "sensors": {"energy": [], "power": []}
                }
        
        # Calculer métadonnées du sensor
        reference_type, reliability = __get_reference_type(platform, not is_virtual)
        priority = __get_priority(sensor_type, reference_type)
        
        # Ajouter sensor avec métadonnées enrichies
        devices[device_id]["sensors"][sensor_type].append({
            "entity_id": entity_id,
            "friendly_name": state.attributes.get("friendly_name", entity_id),
            "unit": state.attributes.get("unit_of_measurement"),
            "device_class": state.attributes.get("device_class"),
            "integration": platform,
            "is_virtual": is_virtual,
            "reference_type": reference_type,
            "reliability_score": reliability,
            "priority": priority,
        })
    
    # Construire résultat avec sélection intelligente
    result = []
    
    for device_id, device_data in devices.items():
        energy_sensors = device_data["sensors"]["energy"]
        power_sensors = device_data["sensors"]["power"]
        
        # Trier par priorité décroissante
        all_sensors = energy_sensors + power_sensors
        all_sensors.sort(key=lambda x: x["priority"], reverse=True)
        
        if not all_sensors:
            continue
        
        # Prendre le sensor avec la plus haute priorité
        best = all_sensors[0]
        
        # Lister les alternatives (pour tests A/B)
        alternatives = [s["entity_id"] for s in all_sensors[1:3]]
        
        result.append({
            "entity_id": best["entity_id"],
            "friendly_name": best["friendly_name"],
            "nom": device_data["name"],
            "zone": device_data["area"],
            "integration": best["integration"],
            "device_id": device_id,
            "type": "energy" if best in energy_sensors else "power",
            "unit": best["unit"],
            "device_class": best["device_class"],
            "is_virtual": best["is_virtual"],
            "reference_type": best["reference_type"],
            "reliability_score": best["reliability_score"],
            "priority": best["priority"],
            "alternatives": alternatives,
            "related_power": power_sensors[0]["entity_id"] if energy_sensors and power_sensors else None,
        })
        
        # Log de sélection
        emoji = "✅" if not best["is_virtual"] else "🔷"
        _LOGGER.debug(
            f"{emoji} {device_data['name']} → {best['reference_type']} "
            f"{best['entity_id']} (priorité: {best['priority']}, fiabilité: {best['reliability_score']}%)"
        )
    
    return result


# ==================== ANNOTATION & DÉDUPLICATION ====================

def __annotate_and_deduplicate(capteurs_raw: List[Dict[str, Any]], quality_map: Dict[str, str]) -> List[Dict[str, Any]]:
    """
    Annote quality_scale et MARQUE les doublons sans les désactiver.
    Le frontend décide quoi afficher/activer.
    """
    # Annoter quality_scale
    for c in capteurs_raw:
        integ = c.get("integration")
        q = quality_map.get(integ, "custom")
        c["quality_scale"] = q
        c["is_premium"] = __is_premium(q)
    
    # Grouper par signature (nom + zone)
    groups: Dict[str, List[Dict[str, Any]]] = {}
    for c in capteurs_raw:
        sig = __device_signature(c)
        groups.setdefault(sig, []).append(c)
    
    # Traiter chaque groupe
    for signature, group in groups.items():
        if len(group) > 1:
            # Trier par priorité (meilleur en premier)
            ordered = sorted(
                group,
                key=lambda x: (
                    x.get("priority", 0),
                    x.get("is_premium", False),
                    not x.get("is_virtual", True),
                ),
                reverse=True
            )
            
            # Marquer le rang de chaque sensor
            for idx, sensor in enumerate(ordered):
                sensor["is_duplicate"] = (idx > 0)
                sensor["is_main_duplicate"] = (idx == 0)
                sensor["duplicate_rank"] = idx + 1
                sensor["duplicate_group"] = signature
                sensor["suggested_enabled"] = (idx == 0)
                sensor["disabled"] = False  # Rien n'est désactivé par défaut
                
                # Liste des alternatives (autres sensors du groupe)
                sensor["alternatives"] = [
                    s["entity_id"] for s in ordered if s["entity_id"] != sensor["entity_id"]
                ][:3]
            
            # Log de détection
            main = ordered[0]
            duplicates_info = ", ".join([
                f"{s['entity_id']} ({s['reference_type']}, {s['priority']})" 
                for s in ordered[1:]
            ])
            _LOGGER.info(
                f"🔍 Doublon détecté '{signature}': {len(ordered)} sensors. "
                f"Suggéré: {main['entity_id']} ({main['reference_type']}, priorité {main['priority']}). "
                f"Alternatives: {duplicates_info}"
            )
        else:
            # Sensor unique
            sensor = group[0]
            sensor["is_duplicate"] = False
            sensor["is_main_duplicate"] = True
            sensor["duplicate_rank"] = 1
            sensor["duplicate_group"] = signature
            sensor["suggested_enabled"] = True
            sensor["disabled"] = False
            sensor["alternatives"] = []
    
    return capteurs_raw


# ==================== POINT D'ENTRÉE ====================

async def run_detect_local(*args, **kwargs) -> List[Dict[str, Any]]:
    """
    Détecte les sensors power/energy depuis Home Assistant.
    
    PRIORITÉ : 
      physical energy > physical power > 
      virtual energy > virtual power
    
    Returns: Liste complète avec métadonnées enrichies
    """
    hass = kwargs.get("hass")

    # Mode avec hass : détection automatique
    if hass is not None:
        quality_map = await hass.async_add_executor_job(__load_quality_map_sync)
        
        # Détecter depuis HA (physique + virtuel)
        capteurs_raw = __detect_from_hass(hass)
        
        # Annoter et dédupliquer (sans désactiver)
        capteurs_final = __annotate_and_deduplicate(capteurs_raw, quality_map)
        
        # Statistiques
        total = len(capteurs_final)
        physical = sum(1 for c in capteurs_final if not c.get("is_virtual"))
        virtual = sum(1 for c in capteurs_final if c.get("is_virtual"))
        energy_count = sum(1 for c in capteurs_final if c.get("type") == "energy")
        power_count = sum(1 for c in capteurs_final if c.get("type") == "power")
        duplicates = sum(1 for c in capteurs_final if c.get("is_duplicate"))
        suggested = sum(1 for c in capteurs_final if c.get("suggested_enabled"))
        
        _LOGGER.info(
            "[DETECT] total=%s, physique=%s, virtuel=%s, energy=%s, power=%s, "
            "doublons_detectes=%s, suggeres_actifs=%s",
            total, physical, virtual, energy_count, power_count, duplicates, suggested
        )
        
        await hass.async_add_executor_job(__write_json_sync, _CAPTEURS_FILE, capteurs_final)
        return capteurs_final
    
    # Mode sans hass : lecture fichier existant
    else:
        quality_map = __load_quality_map_sync()
        capteurs_raw = __read_json_sync(_CAPTEURS_FILE) if os.path.exists(_CAPTEURS_FILE) else []
        capteurs_final = __annotate_and_deduplicate(capteurs_raw, quality_map)
        
        total = len(capteurs_final)
        duplicates = sum(1 for c in capteurs_final if c.get("is_duplicate"))
        suggested = sum(1 for c in capteurs_final if c.get("suggested_enabled"))
        
        print(f"[DETECT] capteurs_total={total}, doublons={duplicates}, suggeres={suggested}")
        __write_json_sync(_CAPTEURS_FILE, capteurs_final)
        return capteurs_final


if __name__ == "__main__":
    import asyncio
    asyncio.run(run_detect_local())
