/* === PANELS DE CONFIGURATION INTERACTIVE === */
.config-panels,
.columns,
#columns-grid {
  display: flex;
  gap: 28px;
  margin-bottom: 20px;
  align-items: flex-start;
  flex-wrap: wrap;
}

/* Grille principale: 3 colonnes desktop, 1 colonne mobile */
#columns-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16px;
  width: 100%;
}

.column {
  background: #f6f8fa;
  border-radius: 10px;
  padding: 18px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  min-width: 320px;
  flex: 1;
}

.column.selected {
  border-left: 4px solid #24a745;
}
.column.alternatives {
  border-left: 4px solid #0078d4;
}
.column.duplicates {
  border-left: 4px solid #b40020;
}

/* Bandeau Capteur de référence */
.reference-panel {
  background: #eef8ff;
  border-radius: 10px;
  padding: 12px 20px;
  margin-bottom: 18px;
  font-size: 1.05em;
  box-shadow: 0 1px 4px rgba(0,0,0,0.04);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}
.reference-icon {
  font-size: 1.4em;
  margin-right: 10px;
}
.reference-title {
  font-weight: bold;
  margin-right: 10px;
}
.reference-name {
  color: #005fa3;
  font-weight: 500;
  margin-right: 12px;
}

/* Badges unifiés */
.badge {
  display: inline-block;
  margin-left: 6px;
  padding: 2px 8px;
  border-radius: 6px;
  font-size: 12px;
  line-height: 1.2;
}
.badge.integration {
  background-color: #0078d4;
  color: #fff;
  font-weight: 600;
}
.badge.device {
  background-color: #eaf8ff;
  color: #0a4;
  font-weight: 600;
}
.badge.duplicate {
  background-color: #fff4e5;
  color: #a60;
  font-weight: 600;
}
.badge.reference {
  background-color: #fff1a8;
  color: #6a5;
  font-weight: 700;
  border-radius: 9px;
}

/* Listes et lignes */
ul { list-style: none; padding-left: 0; margin: 0; }
li {
  margin-bottom: 12px;
  padding: 8px 0 8px 8px;
  border-bottom: 1px solid #ebebeb;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}
li.duplicate { background: #fff7f7; }

.sensor-name {
  font-weight: 500;
  color: #222;
  margin-right: 7px;
}

/* Bouton définir référence (si utilisé) */
.set-reference-btn {
  background: #ffe066;
  color: #5c4c00;
  border: none;
  padding: 5px 10px;
  margin-left: 10px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.91em;
  font-weight: bold;
}
.set-reference-btn:hover {
  background: #ffe699;
  color: #b68f02;
}

/* Checkbox capteur */
.capteur-checkbox {
  margin-right: 8px;
  transform: scale(1.1);
}

/* Tooltips */
.tooltip {
  font-size: 0.95em;
  color: #666;
  margin-left: 8px;
  font-style: italic;
}

/* Blocs par intégration (colonnes 1 et 2) */
.integration-block {
  border: 1px solid #ddd;
  border-radius: 6px;
  padding: 8px;
  margin-bottom: 12px;
}
.integration-block ul { margin: 8px 0 0 24px; padding: 0; }
.integration-block li { margin: 6px 0; }

/* Colonne 3: Doublons par appareil */
.column.duplicates .duplicate-group {
  border: 1px solid #ddd;
  border-radius: 6px;
  padding: 8px;
  margin-bottom: 12px;
}
.column.duplicates .duplicate-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.column.duplicates ul { margin: 8px 0 0 0; padding-left: 0; list-style: none; }
.column.duplicates li { display: flex; align-items: center; gap: 8px; margin: 6px 0; }
.ignored-block {
  border-top: 1px dashed #ccc;
  margin-top: 12px;
  padding-top: 8px;
}
.dup-integration-header {
  font-weight: 600;
  margin: 6px 0 0 0;
}

/* Couleurs live (puissance instantanée) */
.dup-entity.live-green { color: #137333; font-weight: 600; }
.dup-entity.live-red   { color: #b3261e; font-weight: 600; }
.dup-entity.live-gray  { color: #666; }

/* Toggler (chevrons) */
.toggle-btn {
  cursor: pointer;
  color: #333;
  background: transparent;
  border: none;
  font-size: 14px;
  padding: 0 4px;
}

/* Responsive */
@media (max-width: 1200px) {
  #columns-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 800px) {
  #columns-grid { grid-template-columns: 1fr; }
  .column { min-width: 100%; }
  .reference-panel { font-size: 1em; padding: 8px 10px; }
}
/* ========================================
   BADGES DE QUALITÉ
   ======================================== */

.quality-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    margin-left: 8px;
    vertical-align: middle;
    white-space: nowrap;
    border: 1px solid;
}

.quality-badge.excellent {
    background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
    color: #2e7d32;
    border-color: #4caf50;
}

.quality-badge.good {
    background: linear-gradient(135deg, #f1f8e9 0%, #dcedc8 100%);
    color: #558b2f;
    border-color: #8bc34a;
}

.quality-badge.acceptable {
    background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
    color: #e65100;
    border-color: #ff9800;
}

.quality-badge.medium {
    background: linear-gradient(135deg, #fbe9e7 0%, #ffccbc 100%);
    color: #d84315;
    border-color: #ff5722;
}

.quality-badge.poor {
    background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
    color: #c62828;
    border-color: #f44336;
}

.badge-icon {
    font-size: 14px;
    line-height: 1;
}

.badge-label {
    font-weight: 700;
    font-size: 11px;
}

.badge-stars {
    font-size: 13px;
    line-height: 1;
}

.badge-score {
    font-size: 10px;
    opacity: 0.7;
    margin-left: 2px;
}
